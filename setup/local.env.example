# Copy this file to setup/local.env and edit it. local.env is not committed.
#
# Use the ${VAR:-default} form so that a variable set on the command line still wins.

# The SSH name of the server (a Host entry in ~/.ssh/config, or user@address).
COURSE_HOST=${COURSE_HOST:-my-server}

# Where the project is copied to on the server, relative to its home folder.
# COURSE_REMOTE_DIR=${COURSE_REMOTE_DIR:-Projects/Kubernetes}

# The name your browser uses to reach the server. Needed only when the server has
# no Tailscale name (days 5 and 18 build their HTTPS site for this name, and the
# labs print it in their URLs). With Tailscale it is found automatically.
# COURSE_DOMAIN=${COURSE_DOMAIN:-my-server.example.com}
