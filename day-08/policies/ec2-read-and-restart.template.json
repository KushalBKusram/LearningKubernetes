{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyEc2",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "StopAndStartOneInstanceOnly",
      "Effect": "Allow",
      "Action": ["ec2:StopInstances", "ec2:StartInstances"],
      "Resource": "__INSTANCE_ARN__"
    },
    {
      "Sid": "ReadOneBucketOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::day08-reports/*"
    }
  ]
}
